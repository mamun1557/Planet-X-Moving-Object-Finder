# =========================================================================
# SPECTRA-X Observatory — Git Ignore Rules
# NASA Space Apps Challenge 2026 — Team VU_VioNux
# =========================================================================

# Python Virtual Environments
.venv/
.venv*/
venv/
ENV/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend Dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ephemeral Session Scratch & Browser Automation Artifacts
scratch/
*.log
.DS_Store
Thumbs.db

# IDE & Editor Settings
.vscode/
.idea/
.agent/
*.swp
*.swo

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Raw Heavy FITS & Bulk Raw Catalog Dumps (>15MB)
# Note: Calibrated cutouts and manifests are preserved under manifests/ and artifacts/
data/spherex/
data/external_catalogs/
data/processed/spectra/*.csv
reports/phase4/task_4_19B/*.csv
reports/phase4/task_4_28*/screenshots/archive/

# Large Demo/Validation Assets (>25MB)
NASA_DEMO/sample_inputs/fits/level2_*.fits
data/processed/spectral_features/*.csv
reports/phase4/task_4_17/*.csv
